---
import '../styles/site.css';
import StarButton from '../components/StarButton.astro';
import { NEW_ISSUE, RELEASES, REPO_API } from '../site';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Download Herga</title>
    <meta name="description" content="Download Herga, private dictation for Apple Silicon Macs." />
    <link rel="icon" href="/icon.png" />
    <meta name="theme-color" content="#0d0d0c" />
  </head>
  <body>
    <main class="wrap page" data-api={REPO_API} data-releases={RELEASES}>
      <a class="home" href="/"><img src="/icon.png" alt="" width="28" height="28" /> Herga</a>

      <img class="icon" src="/icon.png" alt="" width="104" height="104" />

      <h1 data-title>Getting the latest Herga…</h1>
      <p class="lede" data-status>
        Your download starts in a moment.
        <noscript
          >This page needs JavaScript to find the newest version. <a href={RELEASES}>Download it from GitHub</a
          > instead.</noscript
        >
      </p>
      <p class="fallback" data-fallback hidden>
        Didn’t start? <a data-direct href={RELEASES}>Download it directly</a>.
      </p>

      <ol class="steps" data-steps>
        <li><b>Open the DMG</b> from your Downloads folder.</li>
        <li><b>Drag Herga into Applications.</b> It needs to live there to keep its permissions.</li>
        <li><b>Open Herga</b> and follow setup. It downloads about 2 GB of models while you go.</li>
      </ol>

      <p class="help">Stuck? The <a href="/docs/install/">install guide</a> walks through every step.</p>

      <div class="oss">
        <p>Herga is free and open source. If it saves you some typing, a star helps other people find it.</p>
        <div class="oss-actions">
          <StarButton label="Star on GitHub" size="sm" />
          <a class="issue" href={NEW_ISSUE}>Report an issue</a>
        </div>
      </div>
    </main>
  </body>
</html>

<style>
  .page {
    max-width: 640px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 40px;
    padding-bottom: 64px;
  }

  .home {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
  }

  .home img {
    border-radius: 7px;
  }

  .icon {
    margin: 64px 0 28px;
    border-radius: 24px;
    box-shadow: 0 20px 60px -20px rgba(92, 242, 176, 0.45);
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
  }

  .lede {
    margin: 16px auto 0;
  }

  .lede a,
  .fallback a,
  .help a {
    color: var(--green);
  }

  .fallback {
    margin-top: 12px;
    color: var(--ink-faint);
    font-size: 0.92rem;
  }

  .steps {
    counter-reset: step;
    list-style: none;
    padding: 0;
    margin: 48px 0 0;
    display: grid;
    gap: 12px;
    width: 100%;
    text-align: left;
  }

  .steps[hidden] {
    display: none;
  }

  .steps li {
    counter-increment: step;
    position: relative;
    padding: 18px 20px 18px 50px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-raised);
    color: var(--ink-soft);
  }

  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 22px;
    font-family: var(--font-mono);
    color: var(--green);
  }

  .steps b {
    color: var(--ink);
  }

  .help {
    margin-top: 20px;
    color: var(--ink-faint);
    font-size: 0.92rem;
  }

  .oss {
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
    width: 100%;
    color: var(--ink-soft);
  }

  .oss-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 18px;
    flex-wrap: wrap;
  }

  .issue {
    color: var(--ink-soft);
    font-size: 0.92rem;
  }

  .issue:hover {
    color: var(--ink);
  }
</style>

<script>
  // Ask GitHub for the newest release and start its DMG. The file comes
  // straight from GitHub; this page just finds it.
  type Asset = { name: string; browser_download_url: string };
  type Release = { tag_name: string; assets: Asset[] };

  const page = document.querySelector<HTMLElement>('[data-api]')!;
  const $ = (name: string) => page.querySelector<HTMLElement>(`[data-${name}]`)!;
  const releases = page.dataset.releases!;

  const fail = (title: string, status: string) => {
    $('title').textContent = title;
    $('status').innerHTML = status;
    $('steps').hidden = true;
  };

  fetch(`${page.dataset.api}/releases/latest`, { headers: { Accept: 'application/vnd.github+json' } })
    .then(async (response) => {
      if (response.status === 404) {
        fail(
          'Herga isn’t out yet',
          'The first release is on its way. Star the repository below to hear when it lands.',
        );
        return;
      }
      if (!response.ok) throw new Error(String(response.status));
      const release: Release = await response.json();
      const dmg = release.assets.find((a) => a.name.endsWith('.dmg'));
      if (!dmg) throw new Error('No DMG in the release');

      const version = release.tag_name.replace(/^v/, '');
      $('title').textContent = `Downloading Herga ${version}`;
      $('status').textContent = 'For Macs with Apple Silicon. Your download should start right away.';
      $('direct').setAttribute('href', dmg.browser_download_url);
      $('fallback').hidden = false;
      window.location.href = dmg.browser_download_url;
    })
    .catch(() => {
      fail(
        'Download Herga',
        `We couldn’t reach GitHub to find the newest version. <a href="${releases}">Download it from the Releases page</a> instead.`,
      );
    });
</script>
