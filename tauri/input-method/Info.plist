<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The minimal keys for an input source, from Typut's Info.plist
  (https://github.com/ensan-hcl/Typut, Typut/Info.plist) and Apple's
  InputMethodKit docs:
    InputMethodConnectionName, InputMethodServerControllerClass (IMKServer),
    tsInputMethodCharacterRepertoireKey, tsInputMethodIconFileKey (the
    Text Input Sources system), LSBackgroundOnly (no Dock icon).
  With no ComponentInputModeDict it is a single input source with no modes.
  TISIntendedLanguage files it under English in System Settings.
  The bundle id must contain "inputmethod".
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>VoiceboxInput</string>
	<key>CFBundleIdentifier</key>
	<string>sh.voicebox.inputmethod.VoiceboxInput</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Voicebox Input</string>
	<key>CFBundleDisplayName</key>
	<string>Voicebox Input</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>LSBackgroundOnly</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>InputMethodConnectionName</key>
	<string>sh.voicebox.inputmethod.VoiceboxInput_Connection</string>
	<key>InputMethodServerControllerClass</key>
	<string>VoiceboxInputController</string>
	<key>TISInputSourceID</key>
	<string>sh.voicebox.inputmethod.VoiceboxInput</string>
	<key>TISIntendedLanguage</key>
	<string>en</string>
	<key>tsInputMethodCharacterRepertoireKey</key>
	<array>
		<string>Latn</string>
	</array>
	<key>tsInputMethodIconFileKey</key>
	<string>icon.tiff</string>
</dict>
</plist>
